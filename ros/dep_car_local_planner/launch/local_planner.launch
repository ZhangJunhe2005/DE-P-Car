<launch>
  <arg name="goal_topic" default="/dep_car/local_subgoal"/>
  <arg name="policy_mode" default="disabled"/>
  <arg name="modality" default="fusion"/>
  <arg name="checkpoint" default=""/>
  <arg name="checkpoint_contract" default=""/>
  <arg name="p6_authority" default=""/>
  <arg name="device" default="cuda"/>
  <arg name="fusion_sensor_mode" default="normal"/>
  <arg name="policy_python" default="$(optenv DEP_CAR_POLICY_PYTHON /home/zjh/miniconda3/envs/yopo/bin/python)"/>
  <arg name="active_fallback_to_baseline" default="false"/>
  <arg name="learned_route_authority" default="false"/>
  <arg name="require_goal_heading" default="true"/>
  <arg name="odometry_topic" default="/base_pose_ground_truth"/>
  <!-- Policy state does not need a map-frame pose.  Keep its high-rate
       interpolation source independent from the SLAM-corrected odometry used
       by the geometric planner. -->
  <arg name="policy_odometry_topic" default="$(arg odometry_topic)"/>
  <arg name="odometry_twist_in_body_frame" default="false"/>
  <arg name="publish_dagger_teacher_banks" default="false"/>

  <!-- Keep PyTorch/CUDA in yopo while the safety/actuation node stays on the
       ROS Noetic system Python.  They exchange only typed ROS messages. -->
  <node pkg="dep_car_local_planner" type="policy_node.py" name="dep_car_policy"
        output="screen" launch-prefix="$(arg policy_python)"
        if="$(eval arg('policy_mode') != 'disabled')">
    <param name="mode" value="$(arg policy_mode)"/>
    <param name="modality" value="$(arg modality)"/>
    <param name="checkpoint" value="$(arg checkpoint)"/>
    <param name="checkpoint_contract" value="$(arg checkpoint_contract)"/>
    <param name="p6_authority" value="$(arg p6_authority)"/>
    <param name="device" value="$(arg device)"/>
    <param name="fusion_sensor_mode" value="$(arg fusion_sensor_mode)"/>
    <!-- The learned bank is horizon-based and is re-vetoed against the latest
         grid at the 10 Hz control rate.  Refresh it at 5 Hz so Gazebo depth
         rendering and CUDA inference do not build a shared-GPU queue. -->
    <param name="inference_rate" value="5.0"/>
    <param name="maximum_sensor_age" value="0.35"/>
    <param name="synchronization_history" value="32"/>
    <!-- P3/P5 temporal contract: LiDAR/depth anchor, interpolated vehicle
         state and nearest depth.  These are source-to-anchor distances, not
         an accidental spread between unrelated latest messages. -->
    <param name="depth_sync_tolerance" value="0.05"/>
    <param name="odom_sync_tolerance" value="0.02"/>
    <param name="imu_sync_tolerance" value="0.02"/>
    <param name="joint_sync_tolerance" value="0.05"/>
    <param name="odometry_topic" value="$(arg policy_odometry_topic)"/>
    <param name="odometry_twist_in_body_frame" value="$(arg odometry_twist_in_body_frame)"/>
  </node>

  <node pkg="dep_car_local_planner" type="local_planner_node.py"
        name="dep_car_local_planner" output="screen">
    <param name="goal_topic" value="$(arg goal_topic)"/>
    <param name="control_rate" value="10.0"/>
    <param name="reverse_distance" value="0.85"/>
    <param name="maneuver_leg_distance" value="0.85"/>
    <param name="maneuver_forward_speed" value="0.45"/>
    <param name="maneuver_reverse_speed" value="0.35"/>
    <!-- A large FAR bearing is first handled as a continuous forward course
         capture.  Reverse is considered only if this hard-safe arc vanishes. -->
    <param name="forward_course_capture_speed" value="0.35"/>
    <param name="forward_course_revalidation_timeout_s" value="2.5"/>
    <param name="turnaround_rearm_forward_distance_m" value="1.25"/>
    <!-- Breadcrumb backtracking may exit a small overlap of the *soft* safety
         margin after braking.  Physical footprint collision remains forbidden
         and the signed margin must improve along the selected primitive. -->
    <param name="memory_margin_egress_maximum_overlap" value="0.06"/>
    <param name="memory_margin_egress_minimum_improvement" value="0.02"/>
    <param name="memory_margin_egress_worsening_tolerance" value="0.01"/>
    <!-- Turnaround entry/exit hysteresis and a hard per-primitive yaw-progress
         gate prevent oscillation between opposite steering directions. -->
    <param name="forward_reacquired_bearing" value="1.308996939"/>
    <param name="forward_capture_maximum_bearing" value="2.530727415"/>
    <param name="forward_capture_divergence" value="0.314159265"/>
    <!-- A rolling global-route sample must not turn one transient rearward
         bearing into a gearbox transaction.  At 10 Hz, eight samples retain
         the original turn sign long enough for the next FAR handoff. -->
    <param name="turnaround_behind_confirmation_cycles" value="8"/>
    <param name="forward_reacquired_confirmation_cycles" value="8"/>
    <param name="maneuver_minimum_yaw_progress" value="0.035"/>
    <param name="turnaround_alignment_release_bearing" value="0.872664626"/>
    <param name="turnaround_alignment_minimum_spatial_scale" value="0.75"/>
    <param name="maneuver_retry_observation_hold_s" value="0.75"/>
    <param name="static_recovery_replan_minimum_displacement" value="0.25"/>
    <param name="exact_replan_minimum_displacement" value="0.25"/>
    <param name="terminal_maneuver_radius" value="1.50"/>
    <param name="terminal_maneuver_heading_trigger" value="0.55"/>
    <param name="terminal_capture_radius" value="0.80"/>
    <param name="terminal_capture_speed" value="0.22"/>
    <param name="exact_route_speed" value="0.30"/>
    <param name="route_reference_horizon" value="2.50"/>
    <!-- /global_route and /local_route_command are separate ROS topics but
         one control transaction.  Commit only the matching stamped pair. -->
    <param name="route_transaction_stamp_tolerance" value="0.02"/>
    <param name="route_corridor_weight" value="3.0"/>
    <param name="route_clearance_target" value="0.15"/>
    <param name="route_clearance_weight" value="1.5"/>
    <!-- A strong bend relaxes the A* polyline tether and adds a non-blocking
         swept-footprint halo.  Hard collision geometry is unchanged. -->
    <param name="corner_corridor_minimum_scale" value="0.25"/>
    <param name="corner_soft_clearance_target" value="0.30"/>
    <param name="corner_soft_clearance_weight" value="3.0"/>
    <!-- The route bend drives the long-horizon halo.  Candidate yaw change
         keeps the same soft halo alive when FAR temporarily hands control to
         a short local-exploration reference near a convex corner. -->
    <param name="corner_soft_candidate_trigger" value="0.10"/>
    <param name="corner_soft_candidate_full_strength" value="0.60"/>
    <param name="corner_soft_trigger" value="0.35"/>
    <param name="corner_soft_full_strength" value="1.20"/>
    <param name="corner_straight_speed" value="0.55"/>
    <param name="corner_ninety_speed" value="0.26"/>
    <param name="approach_radius" value="1.5"/>
    <param name="approach_deceleration" value="0.8"/>
    <param name="approach_maximum_speed" value="0.45"/>
    <param name="mission_goal_tolerance" value="0.22"/>
    <param name="mission_heading_tolerance" value="0.35"/>
    <param name="require_goal_heading" value="$(arg require_goal_heading)"/>
    <param name="odometry_topic" value="$(arg odometry_topic)"/>
    <param name="odometry_twist_in_body_frame" value="$(arg odometry_twist_in_body_frame)"/>
    <param name="goal_settled_speed" value="0.02"/>
    <param name="policy_mode" value="$(arg policy_mode)"/>
    <param name="active_fallback_to_baseline" value="$(arg active_fallback_to_baseline)"/>
    <param name="learned_route_authority" value="$(arg learned_route_authority)"/>
    <param name="publish_dagger_teacher_banks" value="$(arg publish_dagger_teacher_banks)"/>
    <!-- Guarded V4.2 compensates asynchronous vehicle motion before the bank
         is checked against the newest static/dynamic occupancy.  Its 0.65 s
         bound covers measured steady inference without permitting an old
         bank to survive a missed refresh indefinitely. -->
    <param name="policy_freshness"
           value="$(eval 0.65 if arg('policy_mode') == 'guarded' else 0.35)"/>
    <!-- This is a current hard-veto grid skew bound, independent of the
         pose-compensated model-bank age above. -->
    <param name="policy_grid_skew" value="0.25"/>
    <param name="policy_subgoal_tolerance" value="0.50"/>
  </node>
</launch>
