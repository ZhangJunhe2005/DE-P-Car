<launch>
  <arg name="goal_topic" default="/dep_car/local_subgoal"/>
  <arg name="policy_mode" default="disabled"/>
  <arg name="modality" default="fusion"/>
  <arg name="checkpoint" default=""/>
  <arg name="checkpoint_contract" default=""/>
  <arg name="p6_authority" default=""/>
  <arg name="device" default="cuda"/>
  <arg name="fusion_sensor_mode" default="normal"/>
  <arg name="policy_python" default="$(optenv DEP_CAR_POLICY_PYTHON /home/zjh/miniconda3/envs/yopo/bin/python)"/>
  <arg name="active_fallback_to_baseline" default="false"/>

  <!-- Keep PyTorch/CUDA in yopo while the safety/actuation node stays on the
       ROS Noetic system Python.  They exchange only typed ROS messages. -->
  <node pkg="dep_car_local_planner" type="policy_node.py" name="dep_car_policy"
        output="screen" launch-prefix="$(arg policy_python)"
        if="$(eval arg('policy_mode') != 'disabled')">
    <param name="mode" value="$(arg policy_mode)"/>
    <param name="modality" value="$(arg modality)"/>
    <param name="checkpoint" value="$(arg checkpoint)"/>
    <param name="checkpoint_contract" value="$(arg checkpoint_contract)"/>
    <param name="p6_authority" value="$(arg p6_authority)"/>
    <param name="device" value="$(arg device)"/>
    <param name="fusion_sensor_mode" value="$(arg fusion_sensor_mode)"/>
    <param name="inference_rate" value="10.0"/>
    <param name="maximum_sensor_age" value="0.35"/>
    <param name="synchronization_history" value="32"/>
    <!-- P3/P5 temporal contract: LiDAR/depth anchor, interpolated vehicle
         state and nearest depth.  These are source-to-anchor distances, not
         an accidental spread between unrelated latest messages. -->
    <param name="depth_sync_tolerance" value="0.05"/>
    <param name="odom_sync_tolerance" value="0.02"/>
    <param name="imu_sync_tolerance" value="0.02"/>
    <param name="joint_sync_tolerance" value="0.05"/>
  </node>

  <node pkg="dep_car_local_planner" type="local_planner_node.py"
        name="dep_car_local_planner" output="screen">
    <param name="goal_topic" value="$(arg goal_topic)"/>
    <param name="control_rate" value="10.0"/>
    <param name="reverse_distance" value="0.85"/>
    <param name="maneuver_leg_distance" value="0.85"/>
    <param name="maneuver_forward_speed" value="0.45"/>
    <param name="maneuver_reverse_speed" value="0.35"/>
    <param name="terminal_maneuver_radius" value="1.50"/>
    <param name="terminal_maneuver_heading_trigger" value="0.55"/>
    <param name="terminal_capture_radius" value="0.80"/>
    <param name="terminal_capture_speed" value="0.22"/>
    <param name="exact_route_speed" value="0.30"/>
    <param name="route_reference_horizon" value="2.50"/>
    <param name="route_corridor_weight" value="3.0"/>
    <param name="route_clearance_target" value="0.15"/>
    <param name="route_clearance_weight" value="1.5"/>
    <param name="corner_straight_speed" value="0.55"/>
    <param name="corner_ninety_speed" value="0.26"/>
    <param name="approach_radius" value="1.5"/>
    <param name="approach_deceleration" value="0.8"/>
    <param name="approach_maximum_speed" value="0.45"/>
    <param name="mission_goal_tolerance" value="0.22"/>
    <param name="mission_heading_tolerance" value="0.35"/>
    <param name="goal_settled_speed" value="0.02"/>
    <param name="policy_mode" value="$(arg policy_mode)"/>
    <param name="active_fallback_to_baseline" value="$(arg active_fallback_to_baseline)"/>
    <param name="policy_freshness" value="0.35"/>
    <param name="policy_grid_skew" value="0.15"/>
    <param name="policy_subgoal_tolerance" value="0.50"/>
  </node>
</launch>
