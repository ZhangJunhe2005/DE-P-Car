<launch>
  <arg name="output" default="$(find dep_car_dataset)/../../../data/static_multimodal_v2"/>
  <arg name="map_uuid"/>
  <arg name="map_hash" default=""/>
  <arg name="simulator_seed" default="-1"/>
  <node pkg="dep_car_dataset" type="collect_multimodal_sample.py" name="dep_car_multimodal_collector" output="screen">
    <param name="output" value="$(arg output)"/>
    <param name="map_uuid" value="$(arg map_uuid)"/>
    <param name="map_hash" value="$(arg map_hash)"/>
    <param name="simulator_seed" value="$(arg simulator_seed)"/>
  </node>
</launch>
