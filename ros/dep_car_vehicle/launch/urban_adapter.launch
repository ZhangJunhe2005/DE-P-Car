<launch>
  <arg name="speed_source" default="ground_truth"/>
  <arg name="odometry_topic" default="/base_pose_ground_truth"/>
  <arg name="publish_ground_truth_tf" default="true"/>
  <rosparam command="load" file="$(find dep_car_vehicle)/config/urban_adapter.yaml" ns="urban_car_adapter"/>
  <node pkg="dep_car_vehicle" type="urban_car_adapter.py" name="urban_car_adapter" output="screen">
    <param name="speed_source" value="$(arg speed_source)"/>
    <param name="odometry_topic" value="$(arg odometry_topic)"/>
  </node>
  <node pkg="dep_car_vehicle" type="odometry_tf_broadcaster.py" name="dep_car_odometry_tf" output="screen" if="$(arg publish_ground_truth_tf)">
    <param name="odometry_topic" value="$(arg odometry_topic)"/>
    <param name="parent_frame" value="map"/>
    <param name="child_frame" value="dummy"/>
  </node>
</launch>
